<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Keep user-supplied Gemini credentials on this device. -->
        <exclude domain="sharedpref" path="theo_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Do not transfer user-supplied Gemini credentials to another device. -->
        <exclude domain="sharedpref" path="theo_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
